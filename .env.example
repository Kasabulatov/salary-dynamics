# Copy to .env and fill in real values. Never commit .env.

# Postgres (local docker container)
POSTGRES_USER=dynamics
POSTGRES_PASSWORD=
POSTGRES_DB=dynamics

# Backend
JWT_SECRET=
REFRESH_SECRET=
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# "lax" for local dev; "none" (+ COOKIE_SECURE=true) when frontend and backend
# are on different domains in production (e.g. Vercel + Render).
COOKIE_SAMESITE=lax

# Frontend
VITE_API_BASE_URL=http://localhost:8080

# Site-wide visitor analytics tag (owner views stats at metrika.yandex.com)
VITE_METRICA_COUNTER_ID=

# Google sign-in (optional — button hidden until both are set). From Google
# Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# Secret ONLY via env, never in chat/git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# This backend's public URL — builds the OAuth redirect_uri, which must match
# what's registered in Google Cloud. Prod: the Render URL.
PUBLIC_API_URL=http://localhost:8080
