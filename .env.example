# Copy to .env and fill in real values. Never commit .env.

# Postgres (local docker container)
POSTGRES_USER=dynamics
POSTGRES_PASSWORD=
POSTGRES_DB=dynamics

# Backend
JWT_SECRET=
REFRESH_SECRET=
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# "lax" for local dev; "none" (+ COOKIE_SECURE=true) when frontend and backend
# are on different domains in production (e.g. Vercel + Render).
COOKIE_SAMESITE=lax

# Frontend
VITE_API_BASE_URL=http://localhost:8080

# v4: Yandex Metrica module
# 64 hex chars (32 bytes) for AES-256-GCM: generate with `openssl rand -hex 32`
TOKEN_ENCRYPTION_KEY=
# From oauth.yandex.com app registration (secret ONLY via env, never in chat/git)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Public URL of this backend (OAuth callback base); prod: the Render URL
PUBLIC_API_URL=http://localhost:8080
# Metrica counter number for the hidden /metrica-test page
VITE_METRICA_COUNTER_ID=
