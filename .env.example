# Copy to .env and fill in real values. Never commit .env.

# Postgres (local docker container)
POSTGRES_USER=dynamics
POSTGRES_PASSWORD=
POSTGRES_DB=dynamics

# Backend
JWT_SECRET=
REFRESH_SECRET=
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# "lax" for local dev; "none" (+ COOKIE_SECURE=true) when frontend and backend
# are on different domains in production (e.g. Vercel + Render).
COOKIE_SAMESITE=lax

# Frontend
VITE_API_BASE_URL=http://localhost:8080
